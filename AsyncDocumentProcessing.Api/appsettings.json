{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=AsyncDocumentProcessingDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "DocumentProcessing": {
    "MaxConcurrency": 3,
    "MaxRetryCount": 3
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}