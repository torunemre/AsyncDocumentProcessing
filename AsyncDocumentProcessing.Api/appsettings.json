{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=AsyncDocumentProcessingDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "DocumentProcessing": {
    "MaxConcurrency": 3,
    "MaxRetryCount": 3,
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}